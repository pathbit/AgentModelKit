{
  "$schema": "https://opencode.ai/config.json",
  "model": "freellmapi/auto",
  "providers": {
    "freellmapi": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "FreeLLMAPI",
      "settings": {
        "baseURL": "http://localhost:3001/v1",
        "apiKey": "{env:FREELLMAPI_API_KEY}"
      },
      "models": {
        "auto": {
          "modelID": "auto",
          "name": "FreeLLMAPI Auto Router",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1114112,
            "input": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
