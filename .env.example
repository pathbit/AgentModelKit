# Exemplo versionado sem credenciais reais.
# Consulte `docs/PROVIDERS.md` e `docs/CLIENTS.md` para detalhes de cada variável.

# Chave opcional da API do OpenCode (se preferir não informar no prompt interativo):
# OPENCODE_API_KEY=

# Chave opcional e endereço dinâmico do FreeLLMAPI local/self-hosted:
# FREELLMAPI_API_KEY=
# FREELLMAPI_URL=http://localhost:3001/v1
# FREELLMAPI_PORT=3001
# FREELLMAPI_CONFIG_PATH=

# Diretórios opcionais de override (úteis para ambientes customizados ou testes):
# COPILOT_HOME=
# COPILOT_PROVIDERS_CONFIG=
# VSCODE_USER_DIR=
