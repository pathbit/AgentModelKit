{
  "name": "@pathbit/agentmodelkit",
  "version": "0.0.1",
  "description": "Cross-platform CLI to configure LLM providers, tiers, and API keys across coding editors and CLIs (VS Code, GitHub Copilot CLI, and extensible targets).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "agentmodelkit": "./bin/agentmodelkit.mjs",
    "amk": "./bin/agentmodelkit.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "data/*.json",
    "data/README*.md",
    "docs/",
    "examples/",
    "tests/README*.md",
    "README.md",
    "README.en.md",
    "README.es.md",
    "CONTRIBUTING*.md",
    "CHANGELOG*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "node bin/agentmodelkit.mjs",
    "setup": "node bin/agentmodelkit.mjs init",
    "setup:copilot": "node bin/agentmodelkit.mjs copilot",
    "setup:vscode": "node bin/agentmodelkit.mjs vscode",
    "doctor": "node bin/agentmodelkit.mjs doctor",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "catalog:update": "node scripts/update-catalogs.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "author": {
    "name": "PathBit",
    "url": "https://www.pathbit.com.br"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "llm-providers",
    "opencode",
    "freellmapi",
    "vscode",
    "github-copilot-cli",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathbit/AgentModelKit.git"
  },
  "bugs": {
    "url": "https://github.com/pathbit/AgentModelKit/issues"
  }
}
